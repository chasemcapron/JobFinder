# Copy to .env.local and fill in what you have. Every value is optional for
# local development: missing keys fall back to mock data or a "not configured"
# state. See README.md for where to get each one.

# --- Database ----------------------------------------------------------------
# Postgres connection string (Neon or Supabase). If empty, a local embedded
# Postgres (PGlite) is created in .data/ automatically. Required in production.
DATABASE_URL=

# --- Auth.js -----------------------------------------------------------------
# Random string used to encrypt sessions. Generate with: npx auth secret
# (or: openssl rand -base64 32). Required in production.
AUTH_SECRET=
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated emails allowed to sign in with Google. Set this in production so
# only you can use the deployed app. Empty = anyone Google lets through.
ALLOWED_EMAILS=
# Optional. "true" shows the demo sign-in button even when Google is configured;
# "false" hides it. Defaults to on only when Google isn't configured (never in production).
ENABLE_DEMO_LOGIN=

# --- Claude (resume extraction + match scoring) ------------------------------
ANTHROPIC_API_KEY=
# Optional model override.
ANTHROPIC_MODEL=
# Optional. Max jobs per search run that get a Claude score (cost control). Default 20.
MAX_AI_SCORES_PER_RUN=

# --- Job sources that need keys ----------------------------------------------
# https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# https://developer.usajobs.gov/apirequest/  (USER_AGENT is the email you registered with)
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# --- Email (morning digest) --------------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=
# Sender, e.g. "Job Finder <jobs@yourdomain.com>" (must be a domain verified in Resend,
# or onboarding@resend.dev for testing to your own address).
EMAIL_FROM=

# --- Cron --------------------------------------------------------------------
# Random string. Vercel sends it as "Authorization: Bearer <CRON_SECRET>" to cron routes.
CRON_SECRET=

# --- Optional ----------------------------------------------------------------
# Public base URL used for links in emails. Defaults to the Vercel production URL or localhost.
APP_URL=
# Optional. "true" replaces every job source with built-in sample postings (offline demo/testing).
# Sample data is also used automatically when there are no target companies and no keyed sources.
MOCK_JOBS=
